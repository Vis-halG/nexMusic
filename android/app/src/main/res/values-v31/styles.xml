<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nexmusic_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <!-- Splash for the app's own dark mode. MainActivity selects it for the
         next launch on Android 13+ with SplashScreen.setSplashScreenTheme. -->
    <style name="LaunchTheme.Dark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/nexmusic_dark_canvas</item>
        <item name="android:windowSplashScreenBackground">@color/nexmusic_dark_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nexmusic_splash_icon_dark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
