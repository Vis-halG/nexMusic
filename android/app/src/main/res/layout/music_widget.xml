<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/music_widget_bg_light">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="nexMusic" android:textColor="#0A0A0A" android:textSize="18sp" android:textStyle="bold" android:ellipsize="end" android:maxLines="1" />
    <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to choose music" android:textColor="#71717A" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/ic_widget_previous" android:contentDescription="Previous song" />
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/ic_widget_play" android:contentDescription="Play" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/ic_widget_next" android:contentDescription="Next song" />
        <ImageButton android:id="@+id/widget_close" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/ic_widget_close" android:contentDescription="Close player" />
    </LinearLayout>
    <TextView android:id="@+id/widget_song1" android:layout_width="match_parent" android:layout_height="32dp" android:textColor="#0A0A0A" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_song2" android:layout_width="match_parent" android:layout_height="32dp" android:textColor="#0A0A0A" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_song3" android:layout_width="match_parent" android:layout_height="32dp" android:textColor="#0A0A0A" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
