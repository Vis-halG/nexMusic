rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/appUsers/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.blocked != true);
    }

    // A blocked client may read its own access status so it can sign out.
    match /appUsers/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow write, list: if false;
    }

    function validSession(data) {
      let id = data.lastDeviceId;
      let session = data.sessions[id];
      return data.keys().hasOnly(['sessions', 'lastDeviceId']) &&
        id is string && id.matches('^[a-zA-Z0-9_-]{1,80}$') &&
        data.sessions is map && data.sessions.size() <= 64 &&
        session.keys().hasOnly(['signedIn', 'lastSeen']) &&
        session.signedIn is bool && session.lastSeen == request.time;
    }
    match /appPresence/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && validSession(request.resource.data) && request.resource.data.sessions.size() == 1;
      allow update: if isOwner(userId) && validSession(request.resource.data) &&
        request.resource.data.sessions.diff(resource.data.sessions).affectedKeys().hasOnly([request.resource.data.lastDeviceId]);
      allow delete, list: if false;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Shared activity contains public song metadata and aggregate counts only.
    // The authenticated Worker writes counters atomically; identities and
    // idempotency receipts in subcollections are never readable by clients.
    match /globalMusic/{songId} {
      allow read: if signedIn();
      allow write: if false;
    }

    function validCategoryName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    function validTitle(title) {
      return title is string && title.size() > 0 && title.size() <= 160;
    }

    function categoryExists(categoryId) {
      return categoryId is string
        && exists(/databases/$(database)/documents/categories/$(categoryId));
    }

    // A song can also be listed in more categories. The optional list holds
    // every one of them, its main categoryId included; older app versions
    // write only categoryId.
    function validCategoryList(data) {
      return !('categoryIds' in data)
        || (data.categoryIds is list
          && data.categoryIds.size() >= 1
          && data.categoryIds.size() <= 20
          && data.categoryId in data.categoryIds);
    }

    // Shared categories: any signed-in user can create, rename or delete one.
    // ownerUid only records who created it.
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && validCategoryName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validCategoryName(request.resource.data.name);
      allow delete: if signedIn();
    }

    // Listing of public uploads stored on Cloudinary. Every signed-in listener
    // can read it and rename, move or remove any entry. Entries are
    // soft-deleted so other phones can sync the removal without re-reading the
    // whole catalogue.
    match /songs/{songId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'kind', 'categoryId', 'categoryIds', 'url', 'publicId',
          'sizeBytes', 'durationMs', 'ownerUid', 'ownerName', 'createdAt',
          'updatedAt', 'deleted'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && validTitle(request.resource.data.title)
        && request.resource.data.kind in ['audio', 'video']
        && categoryExists(request.resource.data.categoryId)
        && validCategoryList(request.resource.data)
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://res[.]cloudinary[.]com/.+')
        && request.resource.data.publicId is string
        && request.resource.data.publicId.size() > 0
        && request.resource.data.publicId.size() <= 300
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes < 100 * 1024 * 1024
        && request.resource.data.durationMs is int
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deleted == false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'categoryId', 'categoryIds', 'deleted', 'updatedAt'])
        && validTitle(request.resource.data.title)
        && categoryExists(request.resource.data.categoryId)
        && validCategoryList(request.resource.data)
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Phones that get activity notifications. The push Worker reads these
    // with its service account; a phone can only register or remove its own.
    match /pushTokens/{phoneId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{userId}/folders/{folderId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    match /users/{userId}/media/{mediaId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'title', 'kind', 'folderId', 'sourceUrl', 'storagePath', 'createdAt'
        ])
        && validTitle(request.resource.data.title)
        && request.resource.data.kind in ['link', 'audio', 'video']
        && request.resource.data.folderId is string;
    }

    function validPlaylist(data) {
      return data.keys().hasOnly(['id','ownerUid','name','cover','description','public','deleted','updatedAt','tracks','members','editors'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.cover is string && data.cover.size() <= 32
        && data.description is string && data.description.size() <= 500
        && data.public is bool && data.deleted is bool && data.updatedAt is int
        && data.tracks is list && data.tracks.size() <= 300
        && data.members is list && data.members.size() <= 50
        && data.editors is list && data.members.hasAll(data.editors)
        && data.ownerUid in data.members && data.ownerUid in data.editors;
    }
    function validJoin(playlistId) {
      let data = request.resource.data;
      let grant = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/playlistJoins/$(playlistId)).data;
      let invite = get(/databases/$(database)/documents/playlistInvites/$(grant.inviteId)).data;
      return invite.playlistId == playlistId && invite.ownerUid == resource.data.ownerUid
        && grant.createdAt == request.time && invite.expiresAt > request.time && !resource.data.deleted
        && data.diff(resource.data).affectedKeys().hasOnly(['members','editors','updatedAt'])
        && data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
        && data.editors.toSet() == (invite.editor ? resource.data.editors.toSet().union([request.auth.uid].toSet()) : resource.data.editors.toSet());
    }
    match /playlists/{playlistId} {
      allow read: if signedIn() && (resource.data.public || request.auth.uid in resource.data.members);
      allow create: if signedIn() && validPlaylist(request.resource.data)
        && request.resource.data.id == playlistId && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid] && request.resource.data.editors == [request.auth.uid];
      allow update: if signedIn() && validPlaylist(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.id == resource.data.id
        && (isOwner(resource.data.ownerUid)
          || (request.auth.uid in resource.data.editors
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','cover','description','tracks','updatedAt']))
          || validJoin(playlistId));
      allow delete: if isOwner(resource.data.ownerUid);
    }
    match /playlistInvites/{inviteId} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow list: if isOwner(resource.data.ownerUid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['playlistId','ownerUid','editor','expiresAt','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/playlists/$(request.resource.data.playlistId)).data.ownerUid == request.auth.uid
        && request.resource.data.editor is bool && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(8,'d');
      allow delete: if isOwner(resource.data.ownerUid);
    }
    match /users/{userId}/playlistJoins/{playlistId} {
      allow read,delete: if isOwner(userId);
      allow create,update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['inviteId','createdAt'])
        && request.resource.data.inviteId is string && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/playlistInvites/$(request.resource.data.inviteId)).data.playlistId == playlistId
        && get(/databases/$(database)/documents/playlistInvites/$(request.resource.data.inviteId)).data.expiresAt > request.time;
    }
    match /users/{userId}/activity/{activityId} {
      allow read,delete: if isOwner(userId);
      allow create,update: if isOwner(userId) && request.resource.data.keys().hasOnly(['song','liked','likedAt','lastPlayed'])
        && request.resource.data.song is map;
    }
    match /users/{userId}/listeningDays/{dayId} {
      allow read,delete: if isOwner(userId);
      allow create,update: if isOwner(userId) && request.resource.data.keys().hasOnly(['date','device','tracks','updatedAt'])
        && request.resource.data.date is string && request.resource.data.tracks is map;
    }
    match /users/{userId}/preferences/{preferenceId} { allow read,write: if isOwner(userId) && preferenceId == 'listening'; }
    function inRoom(roomId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/listeningRooms/$(roomId)).data.members; }
    match /listeningRooms/{roomId} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name','hostUid','members','active','createdAt','playing','positionMs','current','updatedAt'])
        && request.resource.data.hostUid == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.active == true && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.members is list && request.resource.data.members.size() <= 25
        && request.resource.data.hostUid in request.resource.data.members
        && (isOwner(resource.data.hostUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','active','current','playing','positionMs','updatedAt'])
          || (resource.data.active && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && (request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
              || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))));
      match /requests/{requestId} {
        allow read: if inRoom(roomId);
        allow create: if inRoom(roomId) && request.resource.data.keys().hasOnly(['song','requestedBy','votes','createdAt'])
          && request.resource.data.requestedBy == request.auth.uid && request.resource.data.song is map
          && request.resource.data.votes == {} && request.resource.data.createdAt == request.time;
        allow update: if inRoom(roomId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.votes[request.auth.uid] is bool;
        allow delete: if signedIn() && (request.auth.uid == resource.data.requestedBy
          || request.auth.uid == get(/databases/$(database)/documents/listeningRooms/$(roomId)).data.hostUid);
      }
      match /tastes/{userId} { allow read: if inRoom(roomId); allow write: if isOwner(userId) && inRoom(roomId) && request.resource.data.tracks is list && request.resource.data.tracks.size() <= 20; }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
